{
  "name": "kc2",
  "version": "1.0.0",
  "description": "KC2 educational research lab: indirect C2 channel over npm dist-tags (mock tasks only)",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "victim": "node src/victim/agent.js",
    "attacker": "node src/attacker/cli.js",
    "lint": "node scripts/check-source.mjs",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/**/*.js --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80",
    "test:e2e": "sh scripts/smoke-test.sh",
    "check": "npm run lint && npm run test:coverage"
  },
  "keywords": [
    "security-research",
    "supply-chain",
    "npm",
    "dist-tags",
    "c2",
    "educational"
  ]
}
