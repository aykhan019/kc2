# Copy this file to `env.sh` and fill in your values:
#   cp env.sh.example env.sh
#   chmod 600 env.sh
#
# env.sh is git-ignored and must be mode 0600 — it contains your registry token,
# NEVER commit it.
# Both the victim and the attacker auto-load this file at startup
# (see loadEnvFile in src/common/config.js). Real environment variables
# take precedence over values set here.

# --- required for writes (real registry) -----------------------------------
# Granular access token scoped to ONLY your test package, short expiration.
export NPM_C2_TOKEN="npm_replace_me"

# --- registry target ---------------------------------------------------------
# Local verdaccio (safe default):
export NPM_C2_REGISTRY_URL="http://localhost:4873"
export NPM_C2_PACKAGE_NAME="my-package"

# Real npmjs.org (your own throwaway package):
# export NPM_C2_REGISTRY_URL="https://registry.npmjs.org"
# export NPM_C2_PACKAGE_NAME="@your-npm-username/disttag-lab-test"

# --- optional ----------------------------------------------------------------
# export NPM_C2_POLL_INTERVAL="10"
# export NPM_C2_AGENT_ID=""
# export NPM_C2_LOG_FILE="logs/lab.log"
# export NPM_C2_MAX_FILE_BYTES="32768"
# export NPM_C2_FILESYSTEM_ROOT="/path/to/isolated/lab/files"
# export NPM_C2_DOWNLOAD_DIR="downloads"
# export NPM_C2_LOG_LEVEL="info"
# export NPM_C2_REQUEST_TIMEOUT_MS="10000"
# export NPM_C2_MAX_RETRIES="3"
# export NPM_C2_RETRY_BASE_DELAY_MS="500"

# Risky capabilities are OFF by default and require explicit operator opt-in:
# export NPM_C2_ENABLE_FUN_OPS="false"
# export NPM_C2_REVEAL_ENV="false"
# export NPM_C2_ENABLE_SCREENSHOT="false"
# export NPM_C2_SCREENSHOT_MAX_WIDTH="1280"
# Screenshot exfil-by-reference demo (optional): anonymous no-key file share
# (0x0.st / transfer.sh / tmpfiles.org style). Empty = transfer over the channel.
# export NPM_C2_UPLOAD_URL="https://0x0.st"
# export NPM_C2_ENABLE_GEOLOCATE="false"
# WiFi-positioning lookup endpoint for the geolocate task (optional).
# Default working service (no key, MLS-compatible, sets a client User-Agent):
# export NPM_C2_GEOLOCATE_URL="https://api.beacondb.net/v1/geolocate"
# Alternative with an API key (key appended as ?key=):
# export NPM_C2_GEOLOCATE_URL="https://www.googleapis.com/geolocation/v1/geolocate"
# export NPM_C2_GEOLOCATE_KEY="your-api-key"
# Required only for registry.npmjs.org after reading the README warnings:
# export NPM_C2_ALLOW_PUBLIC_REGISTRY="true"
# Required only for an isolated non-TLS lab registry (never for the public internet):
# export NPM_C2_ALLOW_INSECURE_HTTP="false"
